{
  "name": "@blamnetwork/web-tiger",
  "version": "0.1.0",
  "description": "Destiny (Tiger) web services — importable library and standalone Nest server",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "prisma"
  ],
  "scripts": {
    "prebuild": "rimraf dist",
    "proto:generate": "buf generate",
    "proto:watch": "node --watch-path=proto --watch-preserve-output ./scripts/proto-generate.mjs",
    "prisma:generate": "node ./scripts/prisma.mjs generate",
    "tiger:migrate": "node ./scripts/prisma.mjs migrate",
    "build": "npm run prisma:generate && npm run proto:generate && nest build",
    "release": "npm run prisma:generate && npm run proto:generate && node ./scripts/release.mjs",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "nest start",
    "start:dev": "npm run prisma:generate && npm run proto:generate && concurrently -k -n proto,tiger,stamp,nest -c magenta,green,gray,cyan \"npm:proto:watch\" \"npm:tiger:watch\" \"npm:tiger:stamp\" \"nest start --watch --entryFile main --preserveWatchOutput\"",
    "tiger:build": "npm --prefix vendor/tiger ci && npm --prefix vendor/tiger run build -w packages/poodle -w packages/rsat -w packages/gibbon -w packages/bullshcript -w packages/datamine",
    "tiger:watch": "npm --prefix vendor/tiger run dev",
    "tiger:stamp": "node ./scripts/tiger-stamp.mjs",
    "start:prod": "node dist/main",
    "test": "vitest run",
    "validate": "npm run check && vitest run --mode validate && npm run typecheck",
    "prepare": "husky"
  },
  "dependencies": {
    "@blamnetwork/blf": "^1.1.0-beta.10",
    "@blamnetwork/bullshcript": "file:vendor/tiger/packages/bullshcript",
    "@blamnetwork/datamine": "file:vendor/tiger/packages/datamine",
    "@blamnetwork/gibbon": "file:vendor/tiger/packages/gibbon",
    "@blamnetwork/poodle": "file:vendor/tiger/packages/poodle",
    "@blamnetwork/rsat": "file:vendor/tiger/packages/rsat",
    "@bufbuild/protobuf": "^2.13.0",
    "@craftycodie/cstruct": "^2.0.0-alpha.3",
    "@nestjs/common": "11.1.0",
    "@nestjs/core": "11.1.0",
    "@nestjs/platform-express": "11.1.0",
    "@nestjs/swagger": "11.2.0",
    "@prisma/client": "^6.7.0",
    "dotenv": "^16.0.1",
    "express": "5.1.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.2",
    "ws": "^8.22.0",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@bufbuild/buf": "^1.72.0",
    "@bufbuild/protoc-gen-es": "^2.13.0",
    "@nestjs/cli": "11.0.7",
    "@nestjs/schematics": "11.0.5",
    "@types/express": "^5",
    "@types/node": "^24",
    "@types/ws": "^8.18.2",
    "@types/yauzl": "^3.4.0",
    "concurrently": "^9.2.4",
    "esbuild": "^0.28.2",
    "husky": "^9.1.7",
    "postject": "^1.0.0-alpha.6",
    "prisma": "^6.7.0",
    "rimraf": "^3.0.2",
    "typescript": "5.8.3",
    "ultracite": "7.7.0",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "express": "5.1.0"
  }
}
